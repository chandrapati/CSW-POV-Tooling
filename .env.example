# Cisco Secure Workload (CSW / Tetration) API credentials.
#
# Copy this file to `.env` in the directory where you run the scripts and
# fill in real values for the target tenant. `.env` is gitignored and
# MUST NOT be committed.
#
# Generate keys in the CSW UI under:
#   Platform -> API Keys -> Create API Key
#
# Recommended capabilities for read-only inventory/agent reporting:
#   - sensor_management (read)
#   - app_policy_management (read)
#   - flow_inventory_query (read)

CSW_API_URL=https://<your-cluster>.tetrationcloud.com
CSW_API_KEY=replace-with-hex-api-key
CSW_API_SECRET=replace-with-hex-api-secret

# Optional: set to "false" only if your corporate TLS-inspecting proxy breaks chain validation.
# Default is "true". Leave as "true" unless you understand the risk.
CSW_VERIFY_SSL=true
